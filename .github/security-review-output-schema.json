{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YFC repository security review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "security_relevance",
    "summary",
    "threat_model_delta",
    "inspected_surfaces",
    "limitations",
    "confirmed_findings",
    "unvalidated_concerns",
    "residual_risk"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["NO_CONFIRMED_FINDINGS", "CONFIRMED_FINDINGS", "NEEDS_MANUAL_VALIDATION"]
    },
    "security_relevance": {
      "type": "string",
      "enum": ["NONE", "LOW", "RELEVANT"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 3000},
    "threat_model_delta": {"type": "string", "maxLength": 3000},
    "inspected_surfaces": {
      "type": "array",
      "maxItems": 30,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 800}
    },
    "confirmed_findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "affected_boundary",
          "attack_path",
          "evidence",
          "impact",
          "remediation",
          "regression_verification"
        ],
        "properties": {
          "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "affected_boundary": {"type": "string", "minLength": 1, "maxLength": 600},
          "attack_path": {"type": "string", "minLength": 1, "maxLength": 2000},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2500},
          "impact": {"type": "string", "minLength": 1, "maxLength": 1500},
          "remediation": {"type": "string", "minLength": 1, "maxLength": 1500},
          "regression_verification": {"type": "string", "minLength": 1, "maxLength": 1500}
        }
      }
    },
    "unvalidated_concerns": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "reason"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1500}
        }
      }
    },
    "residual_risk": {"type": "string", "maxLength": 2500}
  }
}

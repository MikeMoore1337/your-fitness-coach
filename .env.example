POSTGRES_DB=fitminiapp
POSTGRES_USER=fitminiapp
POSTGRES_PASSWORD=local-dev-password-change-before-sharing
# Local defaults are intentionally mutable tags. Production validation requires verified
# immutable @sha256 references for all three images before deployment.
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# Isolated Allure origin profile. The report root is intentionally fixed to
# /srv/yfc-allure-reports so the forced publisher and read-only Caddy mount cannot drift.
ALLURE_REPORT_ORIGIN_UID=1501
ALLURE_REPORT_ORIGIN_GID=1501
ALLURE_REPORT_ORIGIN_MEMORY_LIMIT=64m
ALLURE_CLOUDFLARED_MEMORY_LIMIT=64m
ALLURE_CLOUDFLARED_TUNNEL_TOKEN=
# Optional direct HTTPS publication through the existing public Caddy. Keep
# empty when the Cloudflare Tunnel/Access transport is selected instead.
ALLURE_PUBLIC_HOSTNAME=
ALLURE_BASIC_AUTH_USER=
ALLURE_BASIC_AUTH_HASH=

# Blue/green deployment safety envelope. Production values must be confirmed from measured host
# headroom before the owner-approved bootstrap/rollout; these local examples are not capacity proof.
DEPLOY_MIN_CPU_COUNT=2
DEPLOY_MIN_AVAILABLE_MEMORY_MB=1536
DEPLOY_MIN_AVAILABLE_DISK_MB=4096
DEPLOY_READINESS_TIMEOUT_SECONDS=180
DEPLOY_OBSERVATION_SECONDS=900
DEPLOY_PROBE_INTERVAL_SECONDS=1
DEPLOY_PROBE_TIMEOUT_SECONDS=5
DEPLOY_GATEWAY_IDLE_TIMEOUT_SECONDS=30
DEPLOY_BACKEND_DRAIN_SECONDS=45s
DEPLOY_WORKER_DRAIN_SECONDS=90s
DEPLOY_BOT_DRAIN_SECONDS=45s

APP_ENV=dev
APP_NAME=Your Fitness Coach
APP_DEBUG=false
# Public website and application can share one backend while using separate hosts.
APP_DOMAIN=app.your-fitness-coach.ru
LANDING_DOMAIN=your-fitness-coach.ru

SECRET_KEY=local-dev-secret-key-change-before-sharing-123456789
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=fit_refresh_token

DATABASE_URL=postgresql+psycopg://fitminiapp:local-dev-password-change-before-sharing@db:5432/fitminiapp
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

ENABLE_DEV_AUTH=true
ENABLE_WEB_AUTH=true
ENABLE_EMAIL_AUTH=false
ADMIN_TELEGRAM_USER_IDS=
FRONTEND_BASE_URL=http://127.0.0.1:8000
# Build-time PWA kill switch. Set false to unregister the YFC service worker and remove its caches.
VITE_PWA_ENABLED=true
# Optional until the production privacy page is published. The bot shows a controlled
# unavailable state when this is empty or is not a public HTTPS URL.
PRIVACY_POLICY_URL=
# Optional fallback ownership tokens for the canonical public landing only.
# Prefer DNS verification where the domain's DNS is owner-controlled. Keep real values in
# the deployment secret store/.env; never commit them.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BACKEND_INTERNAL_URL=http://backend:8000
CLOUDFLARED_TOKEN=
TELEGRAM_BOT_TOKEN=123456:test-token
TELEGRAM_BOT_USERNAME=your_fitness_coach_bot
# Signed Mini App initData must be exchanged promptly after launch.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
BOT_INTERNAL_TOKEN=replace-with-a-separate-random-secret-at-least-32-characters
BOT_POLLING_ENABLED=false
BOT_POLLING_LOCK_DIR=/var/lock/fitminiapp-bot
BOT_CONFLICT_RETRY_SECONDS=300
BOT_PROFILE_SYNC_STATE_PATH=/var/lock/fitminiapp-bot/profile-sync-state.json
# Required only if ENABLE_EMAIL_AUTH=true. Email/password registration stays
# unavailable while the flag is false, even when browser OAuth is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=
# Outbound OAuth discovery and token exchange timeout. A callback cannot issue
# an application session until the provider answers.
OAUTH_HTTP_TIMEOUT_SECONDS=15
# Prefer IPv4 on hosts where DNS returns IPv6 but Docker has no IPv6 route.
OAUTH_FORCE_IPV4=true
# Optional HTTP(S)/SOCKS5 route for Google, Yandex, VK ID and Apple browser OAuth.
OAUTH_PROXY_URL=
# Separate server-only route for Telegram browser OAuth. It is required in prod
# when ENABLE_WEB_AUTH and the Telegram OAuth client are enabled. Dev/test may
# leave it empty. When an SSH SOCKS tunnel runs on the Docker host, use the
# operator-managed endpoint, for example socks5://host.docker.internal:1081.
TELEGRAM_OAUTH_PROXY_URL=
# Optional dedicated route for Bot API polling, profile sync and worker delivery.
# Do not reuse the browser OAuth tunnel unless Bot API compatibility was verified.
TELEGRAM_BOT_PROXY_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# VK ID uses OAuth 2.1 with PKCE; the Web application ID is sufficient.
VK_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
# JWT client secret generated for the Apple Services ID; rotate it before expiry.
APPLE_OAUTH_CLIENT_SECRET=
# Optional read-only branded-food catalog. Disabled keeps the core diary fully local.
# Open Food Facts requires an identifying User-Agent in AppName/Version (contact) form.
FOOD_PROVIDER=disabled
OPEN_FOOD_FACTS_USER_AGENT=
# Optional USDA FoodData Central generic-food search. The key is a secret and stays server-side.
FOOD_USDA_ENABLED=false
USDA_FDC_API_KEY=
# Per-attempt connect/read/write timeout; provider reads retry at most once.
FOOD_PROVIDER_TIMEOUT_SECONDS=4
WORKER_POLL_SECONDS=10
REMINDER_SYNC_SECONDS=60
NOTIFICATION_DELIVERY_CONCURRENCY=8
# Deterministic canonical program import limits. The source file is never persisted.
PROGRAM_IMPORT_MAX_FILE_BYTES=2000000
PROGRAM_IMPORT_MAX_REQUEST_BYTES=2400000
PROGRAM_IMPORT_MAX_ROWS=500
PROGRAM_IMPORT_MAX_COLUMNS=18
PROGRAM_IMPORT_MAX_CELLS=8000
PROGRAM_IMPORT_MAX_CELL_CHARS=512
PROGRAM_IMPORT_MAX_XLSX_ENTRIES=32
PROGRAM_IMPORT_MAX_XLSX_EXPANDED_BYTES=4000000
PROGRAM_IMPORT_MAX_XLSX_COMPRESSION_RATIO=100
PROGRAM_IMPORT_PARSE_TIMEOUT_SECONDS=5
PROGRAM_IMPORT_DRAFT_TTL_MINUTES=60
PROGRAM_IMPORT_CLEANUP_BATCH_SIZE=100
# Web Push is fail-closed by default. When enabled, keep the private VAPID key in the
# deployment secret store (base64url raw 32-byte key, base64url DER, or unencrypted PEM).
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_ENDPOINT_HOSTS=fcm.googleapis.com,*.push.services.mozilla.com,*.push.apple.com,*.notify.windows.com
WEB_PUSH_DELIVERY_TIMEOUT_SECONDS=10
# Pseudonymous application audit events are removed by the worker in bounded batches.
AUDIT_EVENT_RETENTION_DAYS=365
# Editorial ingestion remains off until the owner confirms the private moderation
# workflow, channel identity, rubrics, frequency, sources and copyright policy.
NEWS_INGESTION_ENABLED=false
# Backward-compatible local default. Production sets this to false after Hermes activation;
# this flag disables only legacy YFC source acquisition, not downstream review/publication flow.
NEWS_LEGACY_SOURCE_FETCH_ENABLED=true
NEWS_CHANNEL_ID=
# Optional for a private channel without a public username.
NEWS_CHANNEL_USERNAME=
NEWS_INGESTION_CYCLE_SECONDS=900
NEWS_SOURCE_TIMEOUT_SECONDS=10
NEWS_SOURCE_MAX_BYTES=1048576
NEWS_FETCH_CONCURRENCY=4
NEWS_CANDIDATE_SCORE_THRESHOLD=55
NEWS_RETENTION_DAYS=90
NEWS_DEFER_HOURS=24
NEWS_MAX_REGENERATIONS=3
NEWS_DRAFT_MAX_CHARS=2600
NEWS_DAILY_DRAFT_LIMIT=3
# Low-risk unattended publication stays off until a separate owner checkpoint.
NEWS_DRAFT_PROFILE=standard
NEWS_AUTO_PUBLISH_LOW_RISK=false
# Hermes is an optional narrow candidate/draft intake only; it has no Telegram/channel capability.
HERMES_INTAKE_ENABLED=false
HERMES_INTAKE_KEY_ID=hermes-local
HERMES_INTAKE_SHARED_SECRET=
HERMES_INTAKE_MAX_BODY_BYTES=262144
HERMES_INTAKE_MAX_SOURCE_COUNT=20
HERMES_INTAKE_CLOCK_SKEW_SECONDS=300
HERMES_INTAKE_REPLAY_TTL_SECONDS=900
HERMES_INTAKE_RATE_LIMIT_PER_MINUTE=30
# Disabled uses the local conservative template and never makes an LLM network call.
NEWS_LLM_PROVIDER=disabled
NEWS_LLM_ENDPOINT=
NEWS_LLM_API_KEY=
NEWS_LLM_MODEL=
NEWS_LLM_TIMEOUT_SECONDS=20
NEWS_LLM_PROMPT_VERSION=news-draft-v4
# Images use only a dedicated Cloudflare Workers AI Free account. No paid fallback exists.
NEWS_IMAGE_PROVIDER=disabled
NEWS_IMAGE_CLOUDFLARE_ACCOUNT_ID=
NEWS_IMAGE_CLOUDFLARE_API_TOKEN=
NEWS_IMAGE_CLOUDFLARE_FREE_PLAN_CONFIRMED=false
NEWS_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
NEWS_IMAGE_DAILY_REQUEST_LIMIT=20
NEWS_IMAGE_TIMEOUT_SECONDS=60
NEWS_IMAGE_PROMPT_VERSION=news-image-v1
NEWS_IMAGE_MAX_BYTES=8388608
NEWS_IMAGE_UPLOAD_MAX_BYTES=8388608
# Keep publication off until the bot is an admin in the exact configured channel.
NEWS_PUBLICATION_ENABLED=false
# Exact preview/channel renderer; production channel still requires a separate owner action.
NEWS_PUBLICATION_RENDERER=news-publication-html-v1
NEWS_CHANNEL_ENVIRONMENT=staging
# Set true only after the owner confirms the exact production channel and bot rights.
NEWS_PRODUCTION_PUBLICATION_CONFIRMED=false
NEWS_PUBLICATION_TIMEZONE=Europe/Moscow
NEWS_SCHEDULE_MIN_MINUTES=5
NEWS_SCHEDULE_MAX_DAYS=30
NEWS_SCHEDULE_MISSED_MINUTES=120
NEWS_DAILY_PUBLICATION_LIMIT=1
WEEKLY_DIGEST_ENABLED=false
WEEKLY_DIGEST_CONSENT_VERSION=weekly-news-v1
WEEKLY_DIGEST_MIN_ITEMS=3
WEEKLY_DIGEST_DELIVERY_CONCURRENCY=8

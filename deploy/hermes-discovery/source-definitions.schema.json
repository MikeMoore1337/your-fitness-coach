{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://your-fitness-coach.local/schemas/task129-hermes-source-definitions-v1.json",
  "title": "Task 129 versioned YFC Hermes source definitions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "source_registry",
    "source_registry_sha256",
    "definitions_version",
    "supported_topics",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "hermes-source-definitions-v1"
    },
    "generator": {
      "const": "task403-yfc-source-registry-renderer-v1"
    },
    "source_registry": {
      "const": "backend/fitminiapp_api/resources/news_sources.json"
    },
    "source_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "definitions_version": {
      "type": "string",
      "pattern": "^yfc-news-sources:[0-9a-f]{64}$"
    },
    "supported_topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "sports_nutrition",
          "dietary_supplements",
          "medicine",
          "health",
          "fitness",
          "exercise",
          "training",
          "cardio_endurance",
          "sports_medicine_injuries",
          "bodybuilding",
          "peptides",
          "nutrition",
          "food_products",
          "public_health",
          "healthy_lifestyle",
          "fitness_technology",
          "research",
          "guideline",
          "regulation",
          "product",
          "safety"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "fetch_kind",
          "url",
          "language",
          "enabled",
          "topics",
          "authoritative",
          "allowed_redirect_hosts",
          "allowed_item_hosts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "fetch_kind": {
            "enum": [
              "rss",
              "json_feed",
              "html_metadata"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,8}(?:-[A-Z]{2})?$"
          },
          "enabled": {
            "type": "boolean"
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]{2,64}$"
            }
          },
          "authoritative": {
            "type": "boolean"
          },
          "allowed_redirect_hosts": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
            }
          },
          "allowed_item_hosts": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
            }
          },
          "fetch_interval_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10080
          },
          "freshness_policy": {
            "type": "string",
            "maxLength": 64
          },
          "jurisdiction": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32
            }
          },
          "trust_notes": {
            "type": "string",
            "maxLength": 2000
          },
          "licensing_notes": {
            "type": "string",
            "maxLength": 2000
          },
          "health_claim_limitations": {
            "type": "string",
            "maxLength": 2000
          },
          "adapter": {
            "enum": [
              "pubmed_eutils"
            ]
          }
        }
      }
    }
  }
}
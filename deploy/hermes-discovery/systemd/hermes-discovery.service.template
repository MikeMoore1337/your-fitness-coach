[Unit]
Description=Task 403 bounded Hermes source discovery container
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/opt/hermes /etc/hermes /var/lib/hermes

[Service]
Type=oneshot
# The host-side launcher is the only root process here.  The container itself
# remains non-root and has no Docker socket or host tooling mounted into it.
User=root
Group=root
UMask=0077
Environment=HERMES_DEPLOYMENT_MODE=@HERMES_DEPLOYMENT_MODE@
Environment=COLOCATED_ISOLATED_HERMES=@COLOCATED_ISOLATED_HERMES@
Environment=HERMES_DOCKER_NETWORK=hermes-net
Environment=HERMES_GUARD_STATE_DIR=/var/lib/hermes
Environment=HERMES_YFC_DEPLOYMENT_LOCK=@HERMES_YFC_DEPLOYMENT_LOCK@
ExecCondition=/usr/bin/python3 /opt/hermes/current/hermes_resource_guard.py check --phase discovery --mode ${HERMES_DEPLOYMENT_MODE}
ExecStartPre=/usr/bin/python3 /opt/hermes/current/hermes_egress.py refresh --definitions /etc/hermes/current/source-definitions.json --worker-env /etc/hermes/current/worker.env --network ${HERMES_DOCKER_NETWORK}
ExecStart=/usr/bin/python3 /opt/hermes/current/hermes_resource_guard.py run --phase discovery --mode ${HERMES_DEPLOYMENT_MODE} -- /usr/bin/docker run --rm --name hermes-discovery-once --network=${HERMES_DOCKER_NETWORK} --read-only --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m,uid=10000,gid=10000,mode=700 --mount type=bind,source=/etc/hermes/current/source-definitions.json,target=/opt/hermes/config/source-definitions.json,readonly --mount type=bind,source=/var/lib/hermes,target=/opt/data --cap-drop ALL --security-opt no-new-privileges:true --oom-score-adj 500 --pids-limit 32 --memory 256m --cpus 0.25 --user 10000:10000 --env HERMES_DISCOVERY_MODE=external --env HERMES_DISCOVERY_MAX_SOURCES=20 --env HERMES_DISCOVERY_MAX_CONCURRENCY=4 --env HERMES_DISCOVERY_TIMEOUT_SECONDS=10 --env HERMES_DISCOVERY_MAX_RESPONSE_BYTES=524288 --env HERMES_DISCOVERY_MAX_ITEMS_PER_SOURCE=20 --env HERMES_DISCOVERY_DEFINITIONS=/opt/hermes/config/source-definitions.json --env HERMES_DISCOVERY_DEFINITIONS_SHA256=@SOURCE_DEFINITIONS_SHA256@ @DISCOVERY_IMAGE@ --once
ExecStopPost=-/usr/bin/python3 /opt/hermes/current/hermes_health.py alert --state-dir /var/lib/hermes --outbox-dir /var/lib/hermes/outbox
TimeoutStartSec=180s
RuntimeMaxSec=180s
KillMode=mixed
NoNewPrivileges=true
OOMScoreAdjust=500
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hermes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true
LockPersonality=true
TasksMax=32
MemoryMax=256M
CPUQuota=25%

# Local/mock discovery contract only. Production source definitions are a separate
# read-only generated artifact from the canonical YFC registry.
HERMES_DISCOVERY_MODE=local_mock
HERMES_DISCOVERY_DEFINITIONS=/opt/hermes/config/source-definitions.json
HERMES_DISCOVERY_STATE_DIR=/opt/data
HERMES_DISCOVERY_OUTBOX_DIR=/opt/data/outbox
HERMES_DISCOVERY_TIMEOUT_SECONDS=10
HERMES_DISCOVERY_MAX_SOURCES=20
HERMES_DISCOVERY_MAX_CONCURRENCY=4
HERMES_DISCOVERY_MAX_RESPONSE_BYTES=524288
HERMES_DISCOVERY_MAX_ITEMS_PER_SOURCE=20
HERMES_DISCOVERY_LOCK_STALE_SECONDS=900

# External mode is only a future owner-approved VM configuration. Discovery has
# no provider or YFC credentials in either mode.

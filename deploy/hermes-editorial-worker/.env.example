# Local/mock contract only. Keep this mode until a separate Gate A approval.
HERMES_HOME=/opt/data
HERMES_SOURCE_ALLOWLIST=journal-one
# Must remain the same owner-approved isolated network as the discovery unit.
HERMES_DOCKER_NETWORK=hermes-net
HERMES_PROVIDER_MODE=local_mock
HERMES_PROVIDER_BASE_URL=http://127.0.0.1:18080/v1
HERMES_PROVIDER_API_KEY=
HERMES_PROVIDER_MODEL=mock-editorial-v1
HERMES_PROVIDER_TIMEOUT_SECONDS=3
# Global provider-attempt budget, including a bounded quality repair request; maximum is 2.
HERMES_PROVIDER_MAX_ATTEMPTS=2
HERMES_PROVIDER_RETRY_BACKOFF_SECONDS=0.25
YFC_INTAKE_URL=http://127.0.0.1:18081/api/v1/hermes/editorial/intake
YFC_HERMES_KEY_ID=hermes-local
YFC_HERMES_SHARED_SECRET=
YFC_INTAKE_TIMEOUT_SECONDS=5
TELEGRAM_PREVIEW_URL=http://127.0.0.1:18082/preview
TELEGRAM_PREVIEW_TIMEOUT_SECONDS=5

# External values are shown for the future owner-approved shadow run only; do not enable them
# or create credentials in this stage:
# HERMES_PROVIDER_MODE=external
# HERMES_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
# HERMES_PROVIDER_MODEL=openai/gpt-oss-120b
# YFC_INTAKE_URL=https://app.your-fitness-coach.ru/api/v1/hermes/editorial/intake
# External mode rejects TELEGRAM_PREVIEW_URL and TELEGRAM_PREVIEW_TIMEOUT_SECONDS.

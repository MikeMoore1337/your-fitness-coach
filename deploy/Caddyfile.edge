{
	grace_period 30s
}

:8080 {
	@avatar path /api/v1/me/avatar
	request_body @avatar {
		max_size 6291456
	}

	@auth path /api/v1/auth /api/v1/auth/*
	request_body @auth {
		max_size 65536
	}

	@program_import path /api/v1/programs/imports /api/v1/programs/imports/*
	request_body @program_import {
		max_size 2400000
	}

	@default not path /api/v1/auth /api/v1/auth/* /api/v1/me/avatar /api/v1/programs/imports /api/v1/programs/imports/*
	request_body @default {
		max_size 1048576
	}

	@versioned_assets path /assets/*
	handle @versioned_assets {
		reverse_proxy {$YFC_ACTIVE_UPSTREAM} {
			@asset_missing status 404
			handle_response @asset_missing {
				reverse_proxy {$YFC_ASSET_FALLBACK_UPSTREAM}
			}
		}
	}

	handle {
		reverse_proxy {$YFC_ACTIVE_UPSTREAM}
	}

	handle_errors {
		@too_large expression {http.error.status_code} == 413
		header @too_large Content-Type application/json
		header @too_large Cache-Control "no-store, private"
		respond @too_large `{"detail":"Request body too large","code":"request_body_too_large"}` 413
		respond "Request rejected" {http.error.status_code}
	}
}

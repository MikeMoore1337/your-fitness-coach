[
  {
    "surface": "Progress / page title",
    "selector": ".app-section--progress .progress-hero h1",
    "theme": "dark",
    "token": "--font-display + mobile page scale + --line-height-tight",
    "fontFamily": "Oswald, \"Arial Narrow\", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "fontSize": "30px",
    "fontWeight": "700",
    "lineHeight": "34.5px",
    "text": "Прогресс"
  },
  {
    "surface": "Progress / section selector",
    "selector": ".app-section--progress .progress-category-nav .ui-tab",
    "theme": "dark",
    "token": "--font-body + --font-size-body + --font-weight-medium",
    "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "fontSize": "15px",
    "fontWeight": "600",
    "lineHeight": "22.5px",
    "text": "Обзор"
  },
  {
    "surface": "Today / page title",
    "selector": ".today-dashboard--design-v2 .today-dashboard__header h1",
    "theme": "dark",
    "token": "--font-display + existing Today hero scale",
    "fontFamily": "Oswald, \"Arial Narrow\", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "fontSize": "48px",
    "fontWeight": "700",
    "lineHeight": "64.8px",
    "text": "СЕГОДНЯ"
  },
  {
    "surface": "Today / primary workout title",
    "selector": ".today-dashboard--design-v2 .today-workout-copy h2",
    "theme": "dark",
    "token": "--font-display + existing workout density scale",
    "fontFamily": "Oswald, \"Arial Narrow\", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "fontSize": "32px",
    "fontWeight": "800",
    "lineHeight": "32.96px",
    "text": "Силовая база"
  },
  {
    "surface": "Quick Add / sheet title",
